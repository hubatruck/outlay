includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    ignoreErrors:
        -
            identifiers:
                - missingType.generics
                - return.type
                - argument.type
                - missingType.iterableValue    